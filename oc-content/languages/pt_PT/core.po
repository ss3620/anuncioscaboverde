#, php-format
msgid "Optimization Settings - %s"
msgstr "Configurações de otimização - %s"

#: oc-admin/themes/omega/settings/optimization.php:61
msgid "Optimization Settings"
msgstr "Configurações de otimização"

#: oc-admin/themes/omega/settings/optimization.php:64
msgid "CSS Stylesheets"
msgstr "Folhas de estilo CSS"

#: oc-admin/themes/omega/settings/optimization.php:69
msgid "Merge internal CSS style sheets into one"
msgstr "Mesclar folhas de estilo CSS internas em uma"

#: oc-admin/themes/omega/settings/optimization.php:71
msgid "External stylesheets are not merged."
msgstr "As folhas de estilo externas não são mescladas."

#: oc-admin/themes/omega/settings/optimization.php:77
msgid "Minify/optimize merged CSS style sheet"
msgstr "Minimizar/otimizar folha de estilo CSS mesclada"

