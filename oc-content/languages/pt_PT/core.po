#: oc-admin/themes/omega/settings/optimization.php:116
msgid "Comments and redundant whitespaces will be removed"
msgstr "Comentários e espaços em branco redundantes serão removidos"

#: oc-admin/themes/omega/settings/optimization.php:85
msgid "CSS Exclude words"
msgstr "CSS Excluir palavras"

#: oc-admin/themes/omega/settings/optimization.php:88
msgid ""
"Banned keywords, in case CSS contains this word in link, will be excluded "
"from optimization."
msgstr ""
"Palavras-chave banidas, caso o CSS contenha esta palavra no link, serão "
"excluídas da otimização."

#: oc-admin/themes/omega/settings/optimization.php:93
msgid "CSS Exclude pages"
msgstr "CSS excluir páginas"

#: oc-admin/themes/omega/settings/optimization.php:96
msgid ""
"Exclude optimization of CSS style sheets on particular pages. Example: "
"home, search, item. Optimized scripts are printed before excluded, take it "
"into consideration regarding script dependencies."
msgstr ""
"Exclua a otimização de folhas de estilo CSS em páginas específicas. "
"Exemplo: home, pesquisa, item. Os scripts otimizados são impressos antes de "
"serem excluídos, leve isso em consideração em relação às dependências do "
"script."

#: oc-admin/themes/omega/settings/optimization.php:101
msgid "JS scripts"
msgstr "Scripts JS"

#: oc-admin/themes/omega/settings/optimization.php:106
msgid "Merge internal JS scripts into one"
msgstr "Mesclar scripts JS internos em um"

#: oc-admin/themes/omega/settings/optimization.php:108
msgid "External scripts are not merged."
msgstr "Os scripts externos não são mesclados."

#: oc-admin/themes/omega/settings/optimization.php:114
msgid "Minify/optimize merged JS scripts"
msgstr "Minificar/otimizar scripts JS mesclados"

#: oc-admin/themes/omega/settings/optimization.php:122
msgid "JS Exclude words"
msgstr "JS Excluir palavras"

#: oc-admin/themes/omega/settings/optimization.php:125
msgid ""
"Banned keywords, in case JS script contains this word in link, will be "
"excluded from optimization."
msgstr ""
"Palavras-chave banidas, caso o script JS contenha esta palavra no link, "
"serão excluídas da otimização."

#: oc-admin/themes/omega/settings/optimization.php:130
msgid "JS Exclude pages"
msgstr "JS Excluir páginas"

#: oc-admin/themes/omega/settings/optimization.php:133
msgid ""
"Exclude optimization of JS scripts on particular pages. Example: home, "
"search, item"
msgstr ""
"Exclua a otimização de scripts JS em páginas específicas. Exemplo: página "
"inicial, pesquisa, item"

#: oc-admin/themes/omega/settings/optimization.php:147
#: oc-admin/themes/omega/settings/optimization.php:152
msgid "Clean up optimized files"
msgstr "Limpe ficheiros otimizados"

#: oc-admin/themes/omega/settings/optimization.php:150
